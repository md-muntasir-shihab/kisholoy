{
  "name": "kisholoy",
  "version": "0.1.0",
  "private": true,
  "description": "Kisholoy multi-vendor commerce backend (Medusa application).",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "medusa build",
    "dev": "medusa develop",
