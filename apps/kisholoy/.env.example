# Kisholoy — Medusa application environment
#
# Copy to `.env` for local development. NEVER commit `.env`.
# Every value marked REQUIRED must come from your secret store in production.

# --- runtime -------------------------------------------------------------
NODE_ENV=development

# --- database (REQUIRED) -------------------------------------------------
# Read by packages/core/utils/src/modules-sdk/load-module-database-config.ts
DATABASE_URL=postgres://postgres:postgres@localhost:5432/kisholoy

# --- secrets (REQUIRED in production; the app refuses to start without them)
# Generate: openssl rand -hex 32
JWT_SECRET=
COOKIE_SECRET=

# --- CORS (exact origins, comma separated; "*" is rejected at boot) -------
STORE_CORS=http://localhost:8000,http://localhost:5173,http://localhost:3000
ADMIN_CORS=http://localhost:9000,http://localhost:5173
AUTH_CORS=http://localhost:9000,http://localhost:8000,http://localhost:5173,http://localhost:3000

# --- public base URL of THIS backend -------------------------------------
# Used to build absolute product image URLs during seeding.
MEDUSA_BACKEND_URL=http://localhost:9000

# --- recommended in production -------------------------------------------
# Without Redis, sessions live in process memory and the local event bus and
# in-memory workflow engine are used instead (Medusa logs a warning).
REDIS_URL=

# "server" | "worker" | "shared" — split API and background workers
MEDUSA_WORKER_MODE=server

# --- admin bootstrap (only for `npm run create:admin`) -------------------
# Pass these through your secret store. They are read from the environment on
# purpose: command line arguments are visible to other users on the host via
# /proc/<pid>/cmdline and leak into shell history and CI logs.
ADMIN_EMAIL=
ADMIN_INITIAL_PASSWORD=

# --- storefront (not used by this backend, listed for convenience) -------
# Publishable API key printed at the end of `npm run db:seed`
MEDUSA_PUBLISHABLE_KEY=
